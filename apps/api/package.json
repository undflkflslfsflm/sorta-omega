{
  "name": "@sorta/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --maxWorkers=1 --no-file-parallelism",
    "test:parallel": "vitest run",
    "db:migrate": "tsx src/migrate.ts",
    "worker:provision": "tsx src/provision-worker.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/static": "^10.1.4",
    "@fastify/websocket": "11.2.0",
    "@simplewebauthn/server": "^14.0.2",
    "@sorta/contracts": "workspace:*",
    "dotenv": "^17.2.2",
    "fastify": "^5.6.0",
    "pg": "^8.16.3",
    "rrule": "2.8.1",
    "y-prosemirror": "1.3.7",
    "yjs": "^13.6.32",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.3.1",
    "@types/pg": "^8.15.5",
    "@types/ws": "8.18.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
