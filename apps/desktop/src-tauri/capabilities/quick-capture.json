{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "quick-capture-window",
  "description": "Quick capture can open itself and read text only after an explicit clipboard action.",
  "windows": ["quick-capture"],
  "remote": { "urls": ["http://127.0.0.1:3210/*"] },
  "permissions": ["core:default", "allow-capture-open", "allow-clipboard-capture-selection", "allow-file-import-pick", "allow-native-auth-status", "allow-native-api-request"]
}
