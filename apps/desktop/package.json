{
  "name": "@sorta/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "prebuild": "pnpm --filter @sorta/contracts build",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "pnpm --filter @sorta/contracts build",
    "test": "vitest run",
    "native:info": "tauri info",
    "native:build": "tauri build"
  },
  "dependencies": {
    "@sorta/contracts": "workspace:*"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.4",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
