DATABASE_URL=postgres://sorta:sorta@127.0.0.1:5432/sorta_omega
API_HOST=127.0.0.1
API_PORT=3210
APP_ORIGIN=http://127.0.0.1:5173
BLOB_STORAGE_DIR=./data/blob-storage
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen3.5:4b
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b
# Use openai_compatible on the RTX 4090 host after a compatible quant/runtime passes live tests.
LOCAL_CHAT_BACKEND=ollama
OPENAI_COMPATIBLE_BASE_URL=http://127.0.0.1:8000/v1/
OPENAI_COMPATIBLE_CHAT_MODEL=Qwen/Qwen3.8-Flash-Next
# Required when LOCAL_CHAT_BACKEND=openai_compatible; record the verified model artifact digest, not a guessed value.
OPENAI_COMPATIBLE_CHAT_MODEL_DIGEST=
# Optional bearer secret for a loopback runtime. Never expose the runtime on the LAN.
OPENAI_COMPATIBLE_API_KEY=
# Required for Microsoft/Google OAuth credential encryption (64 hex characters).
OAUTH_CREDENTIAL_KEY_HEX=
# Host-only backup executor key (64 hex characters). Store it in the Windows service secret store and recovery record, never in a backup bundle.
BACKUP_ENCRYPTION_KEY_HEX=
# Absolute checkout path used only by the host maintenance worker to locate reviewed backup scripts.
OMEGA_WORKSPACE_ROOT=
SYSTEM_JOB_POLL_MS=2000
MICROSOFT_CLIENT_ID=
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Keep false unless a public callback path and provider subscriptions were deliberately verified.
PUBLIC_PROVIDER_CALLBACKS_ENABLED=false
# Native local-worker settings; populate only after owner setup and worker provisioning.
OMEGA_API_URL=http://127.0.0.1:3210
OMEGA_WORKER_ID=00000000-0000-0000-0000-000000000000
OMEGA_WORKER_TOKEN=replace-with-the-one-time-provisioned-worker-token
BOOTSTRAP_SECRET=replace-with-a-one-time-setup-secret
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
NODE_ENV=development
